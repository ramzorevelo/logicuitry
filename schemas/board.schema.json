{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lcir/board.schema.json",
  "title": "Logicuitry board (*.board.json)",
  "type": "object",
  "properties": {
    "format": { "const": "lcir.board" },
    "formatVersion": { "const": 12 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/component" }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/group" }
    },
    "hiddenChecks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "wires": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/wire" }
    },
    "junctions": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/junction" }
    },
    "probes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "label": { "type": "string" }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    "view": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "zoom": { "type": "number", "exclusiveMinimum": 0 }
      },
      "required": ["x", "y", "zoom"],
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["ideal", "datasheet"] },
        "datasheet": { "enum": ["min", "typ", "max"] },
        "vendor": { "enum": ["ti", "fairchild"] }
      },
      "required": ["mode", "datasheet", "vendor"],
      "additionalProperties": false
    },
    "runSpeed": {
      "description": "Sim time per wall second while running, in ps.",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000000
    }
  },
  "required": [
    "format",
    "formatVersion",
    "id",
    "name",
    "components",
    "wires",
    "junctions",
    "probes",
    "view",
    "timing",
    "runSpeed"
  ],
  "additionalProperties": false
}
