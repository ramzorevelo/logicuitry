{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lcir/lesson.schema.json",
  "title": "Logicuitry lesson (*.lcirl)",
  "type": "object",
  "properties": {
    "format": { "const": "lcir.lesson" },
    "formatVersion": { "const": 4 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "workbench": { "enum": ["numbers", "gates", "circuit", "devicelab"] },
    "board": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "required": ["format", "formatVersion", "id", "title", "workbench", "steps"],
  "additionalProperties": false,
  "$defs": {
    "step": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["narrate", "predict", "widget"] },
        "prose": { "type": "string" },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "choices": { "type": "array", "items": { "$ref": "#/$defs/choice" } },
        "answer": { "type": "string" },
        "widget": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "params": { "type": "object" }
          },
          "required": ["id"],
          "additionalProperties": false
        },
        "notes": { "type": "string" },
        "headline": { "type": "string" },
        "narr": {
          "type": "object",
          "properties": {
            "at": { "enum": ["panel", "caption", "callout"] },
            "part": { "type": "string", "minLength": 1 }
          },
          "required": ["at"],
          "additionalProperties": false
        },
        "annots": { "type": "array", "items": { "$ref": "#/$defs/annotation" } },
        "revealFreely": { "type": "boolean" },
        "seconds": { "type": "number", "minimum": 1, "maximum": 600 }
      },
      "required": ["kind", "prose", "actions"],
      "additionalProperties": false
    },
    "annotation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "const": "callout" },
            "id": { "type": "string", "minLength": 1 },
            "part": { "type": "string", "minLength": 1 },
            "text": { "type": "string" },
            "offset": { "$ref": "common.schema.json#/$defs/point" },
            "until": { "type": "integer", "minimum": 0 }
          },
          "required": ["kind", "id", "part", "text", "offset"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "text" },
            "id": { "type": "string", "minLength": 1 },
            "at": { "$ref": "common.schema.json#/$defs/point" },
            "text": { "type": "string" },
            "until": { "type": "integer", "minimum": 0 }
          },
          "required": ["kind", "id", "at", "text"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "arrow" },
            "id": { "type": "string", "minLength": 1 },
            "from": { "$ref": "common.schema.json#/$defs/point" },
            "to": { "$ref": "common.schema.json#/$defs/point" },
            "until": { "type": "integer", "minimum": 0 }
          },
          "required": ["kind", "id", "from", "to"],
          "additionalProperties": false
        }
      ]
    },
    "choice": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "right": { "type": "boolean" }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "const": "row" },
            "index": { "type": "integer", "minimum": 0 },
            "set": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
            "when": { "enum": ["open", "reveal"] }
          },
          "required": ["kind", "index", "when"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "power" },
            "on": { "type": "boolean" }
          },
          "required": ["kind", "on"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "timing" },
            "mode": { "enum": ["ideal", "datasheet"] }
          },
          "required": ["kind", "mode"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "highlight" },
            "components": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["kind", "components"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "tab" },
            "tab": { "enum": ["waveform", "analyze", "checks", "sequence"] }
          },
          "required": ["kind", "tab"],
          "additionalProperties": false
        }
      ]
    }
  }
}
