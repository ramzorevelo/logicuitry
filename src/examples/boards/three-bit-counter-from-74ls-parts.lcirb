  "challenge": {
    "title": "Three-bit counter from 74LS parts",
    "brief": "Count 0 to 7 and wrap, one count per rising CLK edge once /CLR goes high; /CLR low holds the count at 0. Q2 Q1 Q0 show the count, Q0 the low bit. Use two 74LS74s and gates from 74LS00, 74LS04, 74LS08, 74LS32 or 74LS86 packages, four ICs at most. Power every chip.",
    "allowed": [
      "74LS74",
      "74LS00",
      "74LS04",
      "74LS08",
      "74LS32",
      "74LS86",
      "clock"
    ],
    "ics": {
      "max": 4
    },
    "required": [
      {
        "anyOf": [
          "74LS74"
        ],
        "count": 2
      }
    ],
    "tests": {
      "clock": "CLK",
      "steps": [
        {
          "set": {
            "/CLR": 0
          },
          "ticks": 1,
          "expect": {
            "Q2": 0,
            "Q1": 0,
            "Q0": 0
          },
          "note": "held clear"
        },
        {
          "set": {
            "/CLR": 1
          },
          "ticks": 1,
          "expect": {
            "Q2": 0,
            "Q1": 0,
            "Q0": 1
          },
          "note": "released"
        },
